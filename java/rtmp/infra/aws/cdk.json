{
  "app": "npx ts-node --prefer-ts-exts bin/rtmp-demo.ts",
  "context": {
    "@aws-cdk/aws-autoscaling:generateLaunchTemplateInsteadOfLaunchConfig": true,
    "deployMode": "cheap",
    "appImage": "public.ecr.aws/docker/library/eclipse-temurin:21-jre",
    "instanceType": "t4g.nano",
    "desiredAppCount": 1,
    "maxAppCount": 3,
    "enableAlb": false,
    "enableNlb": false,
    "enableElastiCache": false,
    "adminCidr": "0.0.0.0/0",
    "rtmpHost": "replace-after-deploy.example.com"
  }
}
